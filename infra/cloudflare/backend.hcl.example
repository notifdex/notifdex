# Copy to backend.hcl (gitignored) and replace placeholders with real values.
# Supply R2 S3 credentials via environment variables (never commit credentials):
#   export AWS_ACCESS_KEY_ID="<r2-access-key-id>"
#   export AWS_SECRET_ACCESS_KEY="<r2-secret-access-key>"

bucket                      = "notifdex-tfstate"
key                         = "cloudflare/terraform.tfstate"
region                      = "auto"
use_lockfile                = true
endpoints                   = { s3 = "https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com" }
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
